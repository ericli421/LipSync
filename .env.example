# Server-only proxy upstream. Judges need only the frontend port (3000).
# PROCESSOR_HTTP_URL=http://127.0.0.1:8000
# Optional direct dashboard override; leave unset for same-origin LAN viewing.
# The APK still uses the laptop LAN address on port 8000 (or USB forwarding).
# NEXT_PUBLIC_PROCESSOR_URL=ws://192.168.1.42:8000/ws
